# ValueQuant Terminal - variables de entorno locales
# Copia este archivo a .env y rellena tus claves reales.
# Nunca subas .env ni claves reales al repositorio.

APP_ENV=local
DEBUG=false

FMP_API_KEY=your_fmp_api_key_here
# Algunos planes de FMP no incluyen el endpoint de noticias (news/stock -> HTTP 402/403
# "Restricted Endpoint"). Desactivado por defecto: actívalo solo si tu plan de FMP lo
# incluye. No afecta al resto de datos (perfil, cotización, estados financieros).
FMP_NEWS_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
